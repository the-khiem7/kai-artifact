---
import { ClientRouter } from "astro:transitions";
import Glyph from "../components/Glyph.astro";
import { url } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: string;
  home?: boolean;
}
const { title, description, lang = "en", home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(url("assets/og.png"), Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("assets/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#04060f" />
    <ClientRouter />
  </head>
  <body data-base={url()} class:list={{ home }}>
    <div class="sky" aria-hidden="true"></div>
    {!home && (
      <header class="nav">
        <div class="wrap">
          <a class="brand" href={url()}><Glyph size={26} />kai-artifact</a>
          <nav class="nav-links" aria-label="Sections">
            <a href={url("#library")}>library</a>
          </nav>
        </div>
      </header>
    )}
    <slot />
    <footer class="site">
      <div class="wrap">
        <span>Source on <a href="https://github.com/the-khiem7/kai-artifact">GitHub</a>. All pages are public.</span>
      </div>
    </footer>
  </body>
</html>
